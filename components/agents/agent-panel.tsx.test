"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import Link from "next/link";
import {
  ArrowLeft,
  CheckCircle2,
  Clock,
  History,
  ListTodo,
  Loader2,
  MessageSquare,
  Monitor,
  RefreshCw,
  Send,
  Settings2,
  Sparkles,
  Trash2,
  XCircle,
  Film,
  X,
  ChevronDown,
} from "lucide-react";
import { toast } from "sonner";
import {
  AGENT_ROLES,
  hasComputer,
  type AgentRoleId,
  type WorkerRoleId,
} from "@/lib/agent-roles";
import type { LiveStatusResponse } from "@/lib/orchestration";
import { ComputerPanel, TeamComputers } from "@/components/sandbox/computer-panel";

interface ChatMessage {
  id: number;
  agentId: string;
  sender: "user" | "agent";
  text: string;
  metadata?: {
    planId?: number;
    images?: string[];
    postIds?: number[];
  };
  createdAt: string;
}

interface PlanRow {
  id: number;
  title: string;
  request: string;
  status: string;
  summary: string | null;
  error: string | null;
  createdAt: string;
}

interface TaskRow {
  id: number;
  planId: number;
  agentId: string;
  position: number;
  title: string;
  instructions: string;
  status: string;
  currentStep: string | null;
  output: string | null;
  error: string | null;
  updatedAt: string;
}

interface ArtifactRow {
  id: number;
  taskId: number | null;
  agentId: string;
  type: string;
  name: string;
  url: string | null;
  sandboxPath: string | null;
}

const MASTER_STARTERS = [
  "Generate a 9:16 launch video reel using Google Flow and schedule it on Facebook and Instagram for 9:00 AM tomorrow",
  "Create two Instagram & Facebook posts for a coffee shop launch and schedule them for 8:00 AM on two consecutive mornings",
  "Analyze our campaign's published post performance and recommend next week's content angles",
];

export function AgentPanel({
  agentId,
  campaignId,
  liveStatus,
  onStatusRefresh,
  onBackToOverview,
  onOpenCreatorStudio,
}: {
  agentId: AgentRoleId;
  campaignId: number;
  liveStatus?: LiveStatusResponse | null;
  onStatusRefresh?: () => void;
  onBackToOverview?: () => void;
  onOpenCreatorStudio?: () => void;
}) {
  const role = AGENT_ROLES[agentId];
  const [activeTab, setActiveTab] = useState<
    "chat" | "tasks" | "computer" | "history" | "settings"
  >("chat");
  const [messages, setMessages] = useState<ChatMessage[]>([]);
  const [hasMore, setHasMore] = useState(false);
  const [loadingChat, setLoadingChat] = useState(true);
  const [loadingMore, setLoadingMore] = useState(false);
  const [input, setInput] = useState("");
  const [sending, setSending] = useState(false);

  const [plans, setPlans] = useState<PlanRow[]>([]);
  const [tasks, setTasks] = useState<TaskRow[]>([]);
  const [artifacts, setArtifacts] = useState<ArtifactRow[]>([]);

  const [customInstructions, setCustomInstructions] = useState("");
  const [agentEnabled, setAgentEnabled] = useState(true);
  const [savingSettings, setSavingSettings] = useState(false);

  // Generated Assets Dropdown/Modal under Creator Agent
  const [showCreatorAssetsModal, setShowCreatorAssetsModal] = useState(false);
  const [creatorAssets, setCreatorAssets] = useState<Array<{ url: string; name: string; time: number }>>([]);
  const [creatorPosts, setCreatorPosts] = useState<Array<{ id: number; title: string }>>([]);
  const [selectedCreatorPostId, setSelectedCreatorPostId] = useState<number>(38);
  const [dismissedCreatorAssets, setDismissedCreatorAssets] = useState<string[]>([]);

  const loadCreatorAssets = async () => {
    try {
      const res = await fetch("/api/flow");
      if (res.ok) {
        const d = await res.json();
        setCreatorAssets(d.localAssets || []);
        setCreatorPosts(d.campaignPosts || []);
        if (d.campaignPosts?.[0]?.id) {
          setSelectedCreatorPostId(d.campaignPosts[0].id);
        }
      }
    } catch {}
  };

  const handleAttachCreatorAsset = async (assetUrl: string) => {
    try {
      const res = await fetch("/api/flow", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "import-to-post",
          mediaUrl: assetUrl,
          postId: selectedCreatorPostId,
        }),
      });
      if (res.ok) {
        toast.success(`Attached to Post #${selectedCreatorPostId}!`);
        onStatusRefresh?.();
      } else {
        toast.error("Could not attach asset");
      }
    } catch {
      toast.error("Could not attach asset");
    }
  };

  const visibleCreatorAssets = creatorAssets.filter(
    (a) => !dismissedCreatorAssets.includes(a.name)
  );

  const bottomRef = useRef<HTMLDivElement>(null);

  // Reset tab if switching to an agent without Tasks or Computer tab
  useEffect(() => {
    if (activeTab === "tasks" && agentId !== "master") {
      setActiveTab("chat");
    }
    if (
      activeTab === "computer" &&
      agentId !== "master" &&
      !hasComputer(agentId)
    ) {
      setActiveTab("chat");
    }
  }, [agentId, activeTab]);

  const fetchMessages = useCallback(async () => {
    try {
      const res = await fetch(`/api/agents/chat?agent=${agentId}`, {
        cache: "no-store",
      });
      if (!res.ok) return;
      const data = await res.json();
      setMessages(data.messages || []);
      setHasMore(Boolean(data.hasMore));
      setCustomInstructions(data.customInstructions || "");
      setAgentEnabled(data.enabled ?? true);
    } finally {
      setLoadingChat(false);
    }
  }, [agentId]);

  const fetchTasksAndHistory = useCallback(async () => {
    try {
      const res = await fetch(`/api/agents/tasks?agent=${agentId}`, {
        cache: "no-store",
      });
      if (!res.ok) return;
      const data = await res.json();
      setPlans(data.plans || []);
      setTasks(data.tasks || []);
      setArtifacts(data.artifacts || []);
    } catch {
      // Ignore transient errors
    }
  }, [agentId]);

  useEffect(() => {
    setLoadingChat(true);
    void fetchMessages();
    void fetchTasksAndHistory();
  }, [agentId, campaignId, fetchMessages, fetchTasksAndHistory]);

  // Continuously refresh messages & tasks automatically every 1.8s
  useEffect(() => {
    const id = setInterval(() => {
      void fetchMessages();
      void fetchTasksAndHistory();
    }, 1800);
    return () => clearInterval(id);
  }, [fetchMessages, fetchTasksAndHistory]);

  async function loadOlderMessages() {
    if (!messages.length || loadingMore) return;
    setLoadingMore(true);
    try {
      const oldestId = messages[0].id;
      const res = await fetch(
        `/api/agents/chat?agent=${agentId}&beforeId=${oldestId}`,
        { cache: "no-store" }
      );
      if (!res.ok) return;
      const data = await res.json();
      setMessages((prev) => [...(data.messages || []), ...prev]);
      setHasMore(Boolean(data.hasMore));
    } finally {
      setLoadingMore(false);
    }
  }

  async function handleSend(customPrompt?: string) {
    const text = (customPrompt ?? input).trim();
    if (!text || sending) return;
    if (!customPrompt) setInput("");
    setSending(true);

    const optimistic: ChatMessage = {
      id: Date.now(),
      agentId,
      sender: "user",
      text,
      createdAt: new Date().toISOString(),
    };
    setMessages((prev) => [...prev, optimistic]);
    setTimeout(() => bottomRef.current?.scrollIntoView({ behavior: "smooth" }), 50);

    try {
      const res = await fetch("/api/agents/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "chat", agentId, message: text }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Agent could not reply");
      await fetchMessages();
      await fetchTasksAndHistory();
      onStatusRefresh?.();
      setTimeout(() => bottomRef.current?.scrollIntoView({ behavior: "smooth" }), 80);
    } catch (err) {
      toast.error(
        err instanceof Error ? err.message : "The agent couldn't reply right now."
      );
    } finally {
      setSending(false);
    }
  }

  async function handleCancelPlan(planId: number) {
    try {
      await fetch("/api/agents/tasks", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "cancel-plan", planId }),
      });
      toast.success("Plan cancelled");
      await fetchTasksAndHistory();
      onStatusRefresh?.();
    } catch {
      toast.error("Failed to cancel plan");
    }
  }

  async function handleRetryTask(taskId: number) {
    try {
      await fetch("/api/agents/tasks", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "retry-task", taskId }),
      });
      toast.success("Task re-queued");
      await fetchTasksAndHistory();
      onStatusRefresh?.();
    } catch {
      toast.error("Failed to retry task");
    }
  }

  async function handleSaveSettings(e: React.FormEvent) {
    e.preventDefault();
    setSavingSettings(true);
    try {
      const res = await fetch("/api/agents/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "save-settings",
          agentId,
          customInstructions,
          enabled: agentEnabled,
        }),
      });
      if (!res.ok) throw new Error("Failed to save");
      toast.success(`Saved ${role.name} settings`);
    } catch {
      toast.error("Could not save settings");
    } finally {
      setSavingSettings(false);
    }
  }

  async function handleClearChat() {
    if (!window.confirm("Are you sure you want to clear this agent's chat history?")) return;
    try {
      const res = await fetch("/api/agents/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "clear", agentId }),
      });
      if (res.ok) {
        setMessages([]);
        toast.success("Cleared conversation");
      } else {
        toast.error("Failed to clear chat");
      }
    } catch {
      toast.error("Failed to clear chat");
    }
  }

  async function handleDeleteMessage(id: number) {
    try {
      const res = await fetch("/api/agents/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "delete-message", messageId: id, agentId }),
      });
      if (res.ok) {
        setMessages((prev) => prev.filter((m) => m.id !== id));
        toast.success("Message deleted");
      } else {
        toast.error("Could not delete message");
      }
    } catch {
      toast.error("Could not delete message");
    }
  }

  const workerLive =
    agentId !== "master" ? liveStatus?.agents?.[agentId as WorkerRoleId] : null;
  const showComputerTab = agentId === "master" || hasComputer(agentId);

  return (
    <div className="flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-xs">
      {/* Agent Header */}
      <div className="flex items-center justify-between gap-3 border-b border-slate-100 px-4 py-3">
        <div className="flex items-center gap-3 min-w-0">
          {onBackToOverview && (
            <button
              type="button"
              onClick={onBackToOverview}
              className="rounded-xl border border-slate-200 p-1.5 text-slate-600 hover:bg-slate-50 cursor-pointer"
              title="Back to Campaign Overview"
            >
              <ArrowLeft className="h-4 w-4" />
            </button>
          )}
          <div className="relative h-10 w-10 shrink-0 overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
            <img
              src={role.avatar}
              alt={role.name}
              className="h-full w-full object-cover object-top"
            />

            {/* Asset Grid with Video Players & Artwork */}
            <div className="flex-1 overflow-y-auto p-5">
              {visibleCreatorAssets.length === 0 ? (
                <div className="py-16 text-center space-y-2">
                  <Film className="h-10 w-10 text-slate-600 mx-auto" />
                  <p className="text-sm font-semibold text-slate-400">No media assets in view</p>
                  <p className="text-xs text-slate-500">
                    Ask Creator Agent in the chat to generate a new anime video reel or concept art.
                  </p>
                </div>
              ) : (
                <div className="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
                  {visibleCreatorAssets.map((asset, idx) => {
                    const isVideo = asset.name.endsWith(".mp4");
                    return (
                      <div
                        key={idx}
                        className="relative group flex flex-col rounded-xl border border-slate-800 bg-slate-950 overflow-hidden shadow-md hover:border-purple-500/50 transition"
                      >
                        {/* Per-Card Cross-out Mark to remove unwanted assets from view */}
                        <button
                          type="button"
                          onClick={() => {
                            setDismissedCreatorAssets((prev) => [...prev, asset.name]);
                            toast.info(`Removed "${asset.name}" from view`);
                          }}
                          className="absolute top-2 right-2 z-10 rounded-full bg-black/75 p-1 text-slate-400 hover:text-rose-400 hover:bg-black transition cursor-pointer"
                          title="Cross out / remove from view"
                        >
                          <X className="h-3.5 w-3.5" />
                        </button>

                        <div className="relative aspect-video w-full bg-black flex items-center justify-center overflow-hidden">
                          {isVideo ? (
                            <video
                              src={asset.url}
                              controls
                              playsInline
                              preload="metadata"
                              className="h-full w-full object-contain"
                            />
                          ) : (
                            <img
                              src={asset.url}
                              alt={asset.name}
                              className="h-full w-full object-cover group-hover:scale-105 transition"
                            />
                          )}
                          <span className="absolute bottom-2 left-2 rounded-md bg-black/80 backdrop-blur px-2 py-0.5 text-[9px] font-bold text-white border border-white/10">
                            {isVideo ? "🎥 9:16 Video Reel (45s)" : "🎨 Anime Artwork"}
                          </span>
                        </div>

                        <div className="p-3 flex flex-col justify-between gap-2 flex-1">
                          <div>
                            <div className="text-xs font-semibold text-slate-200 truncate" title={asset.name}>
                              {asset.name}
                            </div>
                            <div className="text-[10px] text-slate-500">
                              {new Date(asset.time).toLocaleString([], {
                                month: "short",
                                day: "numeric",
                                hour: "2-digit",
                                minute: "2-digit",
                              })}
                            </div>
                          </div>

                          <button
                            type="button"
                            onClick={() => void handleAttachCreatorAsset(asset.url)}
                            className="w-full flex items-center justify-center gap-1.5 rounded-lg bg-linear-to-r from-emerald-600 to-teal-600 px-3 py-1.5 text-xs font-bold text-white hover:opacity-90 shadow-sm transition cursor-pointer"
                          >
                            <CheckCircle2 className="h-3.5 w-3.5" />
                            <span>Attach to Post #{selectedCreatorPostId}</span>
                          </button>
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>

            {/* Dialog Footer with Cross Mark 2 */}
            <div className="border-t border-slate-800 bg-slate-950 px-5 py-3 flex items-center justify-between">
              <span className="text-xs text-slate-400">
                You can attach any video reel or image directly to Facebook & social posts.
              </span>

              {/* Cross Mark 2: Bottom Close Button */}
              <button
                type="button"
                onClick={() => setShowCreatorAssetsModal(false)}
                className="inline-flex items-center gap-1.5 rounded-xl border border-slate-700 bg-slate-800 hover:bg-slate-700 px-4 py-2 text-xs font-bold text-slate-200 hover:text-white transition cursor-pointer"
              >
                <X className="h-3.5 w-3.5" />
                <span>Close Dialog</span>
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
          <div className="min-w-0">
            <div className="flex items-center gap-2">
              <h2 className="text-sm font-bold text-slate-900 truncate">
                {role.emoji} {role.name}
              </h2>
              {workerLive?.status === "running" && (
                <span className="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700">
                  <Loader2 className="h-2.5 w-2.5 animate-spin" />
                  Working
                </span>
              )}

            {/* Asset Grid with Video Players & Artwork */}
            <div className="flex-1 overflow-y-auto p-5">
              {visibleCreatorAssets.length === 0 ? (
                <div className="py-16 text-center space-y-2">
                  <Film className="h-10 w-10 text-slate-600 mx-auto" />
                  <p className="text-sm font-semibold text-slate-400">No media assets in view</p>
                  <p className="text-xs text-slate-500">
                    Ask Creator Agent in the chat to generate a new anime video reel or concept art.
                  </p>
                </div>
              ) : (
                <div className="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
                  {visibleCreatorAssets.map((asset, idx) => {
                    const isVideo = asset.name.endsWith(".mp4");
                    return (
                      <div
                        key={idx}
                        className="relative group flex flex-col rounded-xl border border-slate-800 bg-slate-950 overflow-hidden shadow-md hover:border-purple-500/50 transition"
                      >
                        {/* Per-Card Cross-out Mark to remove unwanted assets from view */}
                        <button
                          type="button"
                          onClick={() => {
                            setDismissedCreatorAssets((prev) => [...prev, asset.name]);
                            toast.info(`Removed "${asset.name}" from view`);
                          }}
                          className="absolute top-2 right-2 z-10 rounded-full bg-black/75 p-1 text-slate-400 hover:text-rose-400 hover:bg-black transition cursor-pointer"
                          title="Cross out / remove from view"
                        >
                          <X className="h-3.5 w-3.5" />
                        </button>

                        <div className="relative aspect-video w-full bg-black flex items-center justify-center overflow-hidden">
                          {isVideo ? (
                            <video
                              src={asset.url}
                              controls
                              playsInline
                              preload="metadata"
                              className="h-full w-full object-contain"
                            />
                          ) : (
                            <img
                              src={asset.url}
                              alt={asset.name}
                              className="h-full w-full object-cover group-hover:scale-105 transition"
                            />
                          )}
                          <span className="absolute bottom-2 left-2 rounded-md bg-black/80 backdrop-blur px-2 py-0.5 text-[9px] font-bold text-white border border-white/10">
                            {isVideo ? "🎥 9:16 Video Reel (45s)" : "🎨 Anime Artwork"}
                          </span>
                        </div>

                        <div className="p-3 flex flex-col justify-between gap-2 flex-1">
                          <div>
                            <div className="text-xs font-semibold text-slate-200 truncate" title={asset.name}>
                              {asset.name}
                            </div>
                            <div className="text-[10px] text-slate-500">
                              {new Date(asset.time).toLocaleString([], {
                                month: "short",
                                day: "numeric",
                                hour: "2-digit",
                                minute: "2-digit",
                              })}
                            </div>
                          </div>

                          <button
                            type="button"
                            onClick={() => void handleAttachCreatorAsset(asset.url)}
                            className="w-full flex items-center justify-center gap-1.5 rounded-lg bg-linear-to-r from-emerald-600 to-teal-600 px-3 py-1.5 text-xs font-bold text-white hover:opacity-90 shadow-sm transition cursor-pointer"
                          >
                            <CheckCircle2 className="h-3.5 w-3.5" />
                            <span>Attach to Post #{selectedCreatorPostId}</span>
                          </button>
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>

            {/* Dialog Footer with Cross Mark 2 */}
            <div className="border-t border-slate-800 bg-slate-950 px-5 py-3 flex items-center justify-between">
              <span className="text-xs text-slate-400">
                You can attach any video reel or image directly to Facebook & social posts.
              </span>

              {/* Cross Mark 2: Bottom Close Button */}
              <button
                type="button"
                onClick={() => setShowCreatorAssetsModal(false)}
                className="inline-flex items-center gap-1.5 rounded-xl border border-slate-700 bg-slate-800 hover:bg-slate-700 px-4 py-2 text-xs font-bold text-slate-200 hover:text-white transition cursor-pointer"
              >
                <X className="h-3.5 w-3.5" />
                <span>Close Dialog</span>
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
            <p className="text-xs text-slate-500 truncate">
              {workerLive?.currentStep || role.tagline}
            </p>

            {/* Asset Grid with Video Players & Artwork */}
            <div className="flex-1 overflow-y-auto p-5">
              {visibleCreatorAssets.length === 0 ? (
                <div className="py-16 text-center space-y-2">
                  <Film className="h-10 w-10 text-slate-600 mx-auto" />
                  <p className="text-sm font-semibold text-slate-400">No media assets in view</p>
                  <p className="text-xs text-slate-500">
                    Ask Creator Agent in the chat to generate a new anime video reel or concept art.
                  </p>
                </div>
              ) : (
                <div className="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
                  {visibleCreatorAssets.map((asset, idx) => {
                    const isVideo = asset.name.endsWith(".mp4");
                    return (
                      <div
                        key={idx}
                        className="relative group flex flex-col rounded-xl border border-slate-800 bg-slate-950 overflow-hidden shadow-md hover:border-purple-500/50 transition"
                      >
                        {/* Per-Card Cross-out Mark to remove unwanted assets from view */}
                        <button
                          type="button"
                          onClick={() => {
                            setDismissedCreatorAssets((prev) => [...prev, asset.name]);
                            toast.info(`Removed "${asset.name}" from view`);
                          }}
                          className="absolute top-2 right-2 z-10 rounded-full bg-black/75 p-1 text-slate-400 hover:text-rose-400 hover:bg-black transition cursor-pointer"
                          title="Cross out / remove from view"
                        >
                          <X className="h-3.5 w-3.5" />
                        </button>

                        <div className="relative aspect-video w-full bg-black flex items-center justify-center overflow-hidden">
                          {isVideo ? (
                            <video
                              src={asset.url}
                              controls
                              playsInline
                              preload="metadata"
                              className="h-full w-full object-contain"
                            />
                          ) : (
                            <img
                              src={asset.url}
                              alt={asset.name}
                              className="h-full w-full object-cover group-hover:scale-105 transition"
                            />
                          )}
                          <span className="absolute bottom-2 left-2 rounded-md bg-black/80 backdrop-blur px-2 py-0.5 text-[9px] font-bold text-white border border-white/10">
                            {isVideo ? "🎥 9:16 Video Reel (45s)" : "🎨 Anime Artwork"}
                          </span>
                        </div>

                        <div className="p-3 flex flex-col justify-between gap-2 flex-1">
                          <div>
                            <div className="text-xs font-semibold text-slate-200 truncate" title={asset.name}>
                              {asset.name}
                            </div>
                            <div className="text-[10px] text-slate-500">
                              {new Date(asset.time).toLocaleString([], {
                                month: "short",
                                day: "numeric",
                                hour: "2-digit",
                                minute: "2-digit",
                              })}
                            </div>
                          </div>

                          <button
                            type="button"
                            onClick={() => void handleAttachCreatorAsset(asset.url)}
                            className="w-full flex items-center justify-center gap-1.5 rounded-lg bg-linear-to-r from-emerald-600 to-teal-600 px-3 py-1.5 text-xs font-bold text-white hover:opacity-90 shadow-sm transition cursor-pointer"
                          >
                            <CheckCircle2 className="h-3.5 w-3.5" />
                            <span>Attach to Post #{selectedCreatorPostId}</span>
                          </button>
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>

            {/* Dialog Footer with Cross Mark 2 */}
            <div className="border-t border-slate-800 bg-slate-950 px-5 py-3 flex items-center justify-between">
              <span className="text-xs text-slate-400">
