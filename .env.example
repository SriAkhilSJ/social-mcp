# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# InsForge / PostgreSQL (optional locally — uses embedded PGlite Postgres in .data/pgdata when empty)
DATABASE_URL=
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
INSFORGE_API_KEY=

# AI Models (OpenAI Agents SDK & Gemini Image/Text)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_PROVIDER=gemini

# E2B Cloud Desktop Sandbox
E2B_API_KEY=

# ImageKit AI Studio & Permanent Media Storage
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# AES-256-GCM Secret Encryption Key (generate with: openssl rand -base64 32)
INTEGRATIONS_ENCRYPTION_KEY=socialix-dev-32-byte-secret-key-change-in-prod!!

# Google Flow Video MCP (45,000 Flow Credits — Veo 3.1 / Omni 1.1 Flash)
FLOW_MCP_URL=http://127.0.0.1:8787
FLOW_MCP_TOKEN=
FLOW_CREDITS_BALANCE=45000
GEMINI_VIDEO_MODEL=veo-2.0-generate-001

# Optional Default OpenPost MCP Server (works alongside Blotato MCP & Facebook Graph API v25.0)
OPENPOST_MCP_URL=http://localhost:8080/mcp
OPENPOST_API_TOKEN=
META_GRAPH_API_VERSION=v25.0

# Inngest (Production only; local uses `npm run inngest:dev`)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
